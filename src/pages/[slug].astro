---
import Layout from '@/ui/layout/Layout.astro';
import MetaData from '@/ui/meta/MetaData.astro';
import Pagination from '@/ui/pagination/Pagination.astro';
import PostCard from '@/ui/posts/PostCard.astro';
import ArticleContent from '@/ui/layout/ArticleContent.astro';
import PostFeed from '@/ui/posts/PostFeed.astro';
import TagHeader from '@/ui/layout/TagHeader.astro';
import {
  buildPaginationContext,
  getTagPagePath,
  paginateItems,
  POSTS_PER_PAGE,
} from '@/lib/content';
import {
  getAllPages,
  getAllTags,
  getSiteSettings,
  getPageBySlug,
  getPostsByTagSlug,
  getTagBySlug,
} from '@/lib/content-data';
import type { BlogPage, BlogPost, BlogTag } from '@/lib/content-types';
import { canonicalFromPath } from '@/lib/site';

interface RouteProps {
  kind: 'page' | 'tag';
}

export async function getStaticPaths() {
  const pages = await getAllPages();
  const tags = await getAllTags();

  return [
    ...pages.map((page) => ({
      params: { slug: page.slug },
      props: { kind: 'page' as const },
    })),
    ...tags.map((tag) => ({
      params: { slug: tag.slug },
      props: { kind: 'tag' as const },
    })),
  ];
}

const { slug } = Astro.params;
const { kind } = Astro.props as RouteProps;

const settings = getSiteSettings();
const currentPath = `/${slug}/`;
const canonical = canonicalFromPath(currentPath);

let page: BlogPage | null = null;
let tag: BlogTag | null = null;
let paginatedPosts: BlogPost[] = [];
let numberOfPages = 1;
let totalTagPosts = 0;

if (kind === 'page') {
  page = await getPageBySlug(slug || '');

  if (!page) {
    throw new Error(`Unable to find page for route ${currentPath}`);
  }
} else {
  tag = await getTagBySlug(slug || '');

  if (!tag) {
    throw new Error(`Unable to find tag for route ${currentPath}`);
  }

  const allTagPosts = await getPostsByTagSlug(slug || '');
  const paginated = paginateItems(allTagPosts, POSTS_PER_PAGE, 1);
  paginatedPosts = paginated.items;
  numberOfPages = paginated.numberOfPages;
  totalTagPosts = allTagPosts.length;
}

const pagination = buildPaginationContext(1, numberOfPages, (pageNumber) =>
  getTagPagePath(slug || '', pageNumber),
);
---

<Layout settings={settings} currentPath={currentPath}>
  <Fragment slot='head'>
    {
      page ? (
        <MetaData settings={settings} canonical={canonical} page={page} />
      ) : (
        <MetaData settings={settings} canonical={canonical} tag={tag!} />
      )
    }
  </Fragment>

  {
    page ? (
      <div class='container'>
        <ArticleContent title={page.title} html={page.html} />
      </div>
    ) : (
      <div class='container'>
        <TagHeader title={tag?.name || ''} description={tag?.description} count={totalTagPosts} />
        <PostFeed>
          {paginatedPosts.map((post, index) => <PostCard post={post} index={index + 1} />)}
        </PostFeed>
        <Pagination {...pagination} />
      </div>
    )
  }
</Layout>
