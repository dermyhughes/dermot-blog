---
import Layout from '@/ui/layout/Layout.astro';
import MetaData from '@/ui/meta/MetaData.astro';
import Pagination from '@/ui/pagination/Pagination.astro';
import PostCard from '@/ui/posts/PostCard.astro';
import PostFeed from '@/ui/posts/PostFeed.astro';
import TagHeader from '@/ui/layout/TagHeader.astro';
import {
  buildPaginationContext,
  getTagPagePath,
  paginateItems,
  POSTS_PER_PAGE,
} from '@/lib/content';
import {
  getAllPosts,
  getAllTags,
  getSiteSettings,
  getPostsByTagSlug,
  getTagBySlug,
} from '@/lib/content-data';
import { canonicalFromPath } from '@/lib/site';

export async function getStaticPaths() {
  const [tags, posts] = await Promise.all([getAllTags(), getAllPosts()]);

  const tagToPosts = new Map<string, number>();
  posts.forEach((post) => {
    post.tags.forEach((tagSlug) => {
      tagToPosts.set(tagSlug, (tagToPosts.get(tagSlug) || 0) + 1);
    });
  });

  const paths: Array<{ params: { slug: string; page: string } }> = [];

  tags.forEach((tag) => {
    const postCount = tagToPosts.get(tag.slug) || tag.postCount || 0;
    const totalPages = Math.ceil(postCount / POSTS_PER_PAGE);

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: {
          slug: tag.slug,
          page: String(page),
        },
      });
    }
  });

  return paths;
}

const slug = Astro.params.slug || '';
const pageNumber = Number(Astro.params.page);
const settings = getSiteSettings();
const tag = await getTagBySlug(slug);

if (!tag) {
  throw new Error(`Unable to find tag for route /${slug}/`);
}

const allTagPosts = await getPostsByTagSlug(slug);
const { items: paginatedPosts, numberOfPages } = paginateItems(allTagPosts, POSTS_PER_PAGE, pageNumber);
const pagination = buildPaginationContext(pageNumber, numberOfPages, (page) => getTagPagePath(slug, page));
const currentPath = getTagPagePath(slug, pageNumber);
const canonical = canonicalFromPath(currentPath);
---

<Layout settings={settings} currentPath={currentPath}>
  <Fragment slot='head'>
    <MetaData settings={settings} canonical={canonical} tag={tag} />
  </Fragment>

  <div class='container'>
    <TagHeader title={tag.name} description={tag.description} count={allTagPosts.length} />
    <PostFeed>
      {
        paginatedPosts.map((post, index) => (
          <PostCard post={post} index={(pageNumber - 1) * POSTS_PER_PAGE + index + 1} />
        ))
      }
    </PostFeed>
    <Pagination {...pagination} />
  </div>
</Layout>
