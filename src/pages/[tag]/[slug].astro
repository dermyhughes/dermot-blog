---
import Layout from '@/ui/layout/Layout.astro';
import MetaData from '@/ui/meta/MetaData.astro';
import PostArticle from '@/ui/layout/PostArticle.astro';
import { getPostTagSlug } from '@/lib/content';
import { getAllPosts, getSiteSettings } from '@/lib/content-data';
import { canonicalFromPath } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: {
      tag: getPostTagSlug(post),
      slug: post.slug,
    },
  }));
}

const { tag, slug } = Astro.params;
const settings = getSiteSettings();
const posts = await getAllPosts();
const postIndex = posts.findIndex((item) => item.slug === slug && getPostTagSlug(item) === tag);
const post = postIndex >= 0 ? posts[postIndex] : undefined;

if (!post) {
  throw new Error(`Unable to find post for route /${tag}/${slug}/`);
}

// Posts are sorted newest-first, so the previous index is the newer post.
const newerPost = postIndex > 0 ? posts[postIndex - 1] : null;
const olderPost = postIndex < posts.length - 1 ? posts[postIndex + 1] : null;

const currentPath = `/${tag}/${slug}/`;
const canonical = canonicalFromPath(currentPath);
---

<Layout settings={settings} currentPath={currentPath}>
  <Fragment slot='head'>
    <MetaData settings={settings} canonical={canonical} post={post} />
  </Fragment>

  <div class='container'>
    <PostArticle post={post} newerPost={newerPost} olderPost={olderPost} />
  </div>
</Layout>
